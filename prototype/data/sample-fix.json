{
  "pr": {
    "number": "482",
    "title": "fix: skip records with an unrecognized category",
    "repo": "example/orders-service"
  },
  "decisions": [
    {
      "id": "d1",
      "title": "Skip unrecognized categories — don't throw",
      "source": "author",
      "chose": "Detect the out-of-union value and pass the record over.",
      "rejected": "Let it reach the exhaustive switch and throw, or widen the union to accept it",
      "why": "The upstream service emits categories outside our closed union; its generated client surfaces them as an unknown-enum sentinel that adapters cast in blindly. That value hit an exhaustive switch and threw — and since the handler logs-and-rethrows, it became a poison-message retry loop. The upstream team confirmed these records should be ignored.",
      "quote": "We confirmed with the upstream team that these records should be ignored / passed over.",
      "quoteSrc": "PR description · Root cause",
      "evidence": [
        {
          "kind": "divergence",
          "provenance": "author",
          "provNote": "Before-state is the author's own root-cause account, not reconstruction.",
          "provSrc": "PR description · Root cause",
          "before": [
            {
              "step": "Event arrives · category = \"__unknown__\"",
              "note": "adapters cast the sentinel straight into the domain type"
            },
            {
              "step": "flows into categoryLabel",
              "note": "exhaustive switch, no arm matches",
              "bad": true
            },
            {
              "step": "throws on the unrecognized value",
              "note": "handler logs and rethrows",
              "bad": true
            },
            {
              "step": "queue redelivers → poison-retry loop",
              "note": "the error-tracking monitor fires",
              "bad": true,
              "terminal": true
            }
          ],
          "after": [
            {
              "step": "Event arrives · category = \"__unknown__\"",
              "note": "same input reaches the subscription"
            },
            {
              "step": "shouldSkipUnrecognizedCategory → true",
              "note": "record.category is not in RECOGNIZED_CATEGORIES"
            },
            {
              "step": "return — no record fetch, no downstream call, no throw",
              "note": "message acknowledged; nothing downstream runs",
              "good": true,
              "terminal": true
            }
          ],
          "divergeAt": 1,
          "divergeNote": "order-subscription.ts:279 — the guard that is the fix",
          "tests": [
            { "name": "skips and meters a record with an unrecognized category", "file": "src/subscription/order-subscription.test.ts" },
            { "name": "does not throw or fetch downstream on the sentinel", "file": "src/subscription/order-subscription.test.ts" }
          ],
          "code": {
            "file": "src/subscription/order-subscription.ts",
            "lines": "276-281",
            "hl": [
              279,
              279
            ],
            "context": false,
            "rows": [
              [
                "276",
                "  async orderCreated({ order: record, occurred }): Promise<void> {",
                0
              ],
