                "277",
                "    await this.trace(\"orderCreated\", async (span) => {",
                0
              ],
              [
                "278",
                "      span?.setTag(\"order_id\", record.id);",
                0
              ],
              [
                "279",
                "      if (this.shouldSkipUnrecognizedCategory(record)) return;",
                1
              ],
              [
                "280",
                "      const customer = await this.orderCustomer(record);",
                0
              ],
              [
                "281",
                "      if (!customer) return;",
                0
