              "note": "same bad value, on a neighbouring record",
              "bad": true
            },
            {
              "step": "shouldSkipUnrecognizedCategory(linked) → guarded off",
              "note": "linkedRecord stays null instead of being built"
            },
            {
              "step": "Current event ships without linked-record data",
              "note": "the current event is not lost",
              "good": true,
              "terminal": true
            }
          ],
