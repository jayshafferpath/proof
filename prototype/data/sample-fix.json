    {
      "id": "d3",
      "title": "Treat an unrecognized LINKED record as absent",
      "source": "author",
      "chose": "Behave as if there is no linked record.",
      "rejected": "Throw while building linked-record event properties",
      "why": "Enrichment reads the record's linked sibling. If that record carries a sentinel category, the same switch would throw mid-enrichment — turning an unprocessable neighbour into a failure of the current event. Treating it as absent degrades gracefully: the current event still ships.",
      "quote": "Treat a linked record with an unrecognized category as if there were none, rather than throwing while building its event properties.",
      "quoteSrc": "code comment · order-subscription.ts:643",
      "evidence": [
        {
          "kind": "trace",
          "trace": [
            {
              "step": "Enriching an event, fetch the linked record",
              "note": "adds related-record properties to the current event"
