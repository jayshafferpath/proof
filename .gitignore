# Generated walkthroughs are build artifacts, never source. They are produced by
# generate.js from prototype/data/*.json and regenerated with `./build.sh`.
# Committing them invites hand-edits that the next render silently destroys.
prototype/*.html
protos/*.html

# Default output dir for proof / proof-retrofit / the /proof:* skills when run
# from within this repo. Disposable renders + reduced spines, not source.
proof-out/

# Scratch state for live decision capture (.plans/live-decision-capture.md) —
# working files the ledger is distilled from, not the ledger itself.
# .proof/ledgers/<ticket>.ledger.jsonl is committed; the per-branch scratch is not.
.proof/scratch/

.DS_Store
